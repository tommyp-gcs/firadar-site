  /* ── Compute stats ── */
  const avg = Math.round(companies.reduce((s, c) => s + c[1], 0) / companies.length);
  document.getElementById('stat-avg').textContent = avg;
  document.getElementById('stat-elite').textContent = companies.filter(c => c[2] === 'elite').length;

  /* ── Build board ── */
  const board = document.getElementById('board');
  let lastTier = null;

  companies.forEach(([name, score, tier, bos, url], i) => {
    const rank = i + 1;

    // Tier divider
    if (tier !== lastTier) {
      const div = document.createElement('div');
      div.className = 'tier-divider';
      div.dataset.tier = tier;
      div.innerHTML = `
        <div class="tier-divider-dot" style="background:${TIERS[tier].color}"></div>
        <span style="color:${TIERS[tier].color}">${TIERS[tier].label}</span>
        <div class="tier-divider-line"></div>
      `;
      board.appendChild(div);
      lastTier = tier;
    }

    const pct = (score / BAR_MAX * 100).toFixed(1);
    const isTop3 = rank <= 3;

    const row = document.createElement('a');
    row.href = url || '#';
    row.target = url ? '_blank' : '_self';
    row.rel = 'noopener noreferrer';
    row.className = `board-row tier-${tier}${isTop3 ? ' top3' : ''}`;
    row.dataset.tier = tier;
    row.setAttribute('aria-label', `${name} — FiRadar Score ${score}`);

    row.innerHTML = `
      <div class="board-rank">${rank}</div>
      <div class="board-name">${name}${bos ? '<span class="bos-badge">⭐ BOS</span>' : ''}</div>
      <div class="board-bar"><div class="board-bar-fill" style="width:${pct}%"></div></div>
      <div class="board-score">${score}</div>
    `;
    board.appendChild(row);
  });

  /* ── Filter buttons ── */
  const filterBar = document.getElementById('filter-bar');
  const countLabel = document.getElementById('count-label');

  filterBar.addEventListener('click', e => {
    const btn = e.target.closest('.filter-btn');
    if (!btn) return;

    const tier = btn.dataset.tier;

    filterBar.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    const rows = board.querySelectorAll('.board-row');
    const dividers = board.querySelectorAll('.tier-divider');
    let visible = 0;

    if (tier === 'all') {
      rows.forEach(r => { delete r.dataset.hidden; visible++; });
      dividers.forEach(d => { delete d.dataset.hidden; });
      countLabel.textContent = `Showing all 70 companies`;
    } else {
      rows.forEach(r => {
        if (r.dataset.tier === tier) { delete r.dataset.hidden; visible++; }
        else r.dataset.hidden = '';
      });
      dividers.forEach(d => {
        d.dataset.hidden = d.dataset.tier !== tier ? '' : undefined;
        if (d.dataset.tier === tier) delete d.dataset.hidden;
        else d.dataset.hidden = '';
      });
      const label = TIERS[tier]?.label || tier;
      countLabel.textContent = `Showing ${visible} ${label} company${visible !== 1 ? 'ies' : 'y'}`;
    }
  });

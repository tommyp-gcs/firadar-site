  { id:17, name:"Splunk",             score:295, tier:"FI Minimal Signal", tierClass:"t-early",      wedge:"SIEM & Compliance",       wedgeColor:"#C084FC", flags:["Acquisition"],
    reach:"Enterprise including financial services — SIEM and observability",
    text:["<b>Why it scores Early Stage:</b> Splunk has one of the largest FI installed bases of any SIEM platform but scores lower as the Cisco acquisition reshapes roadmap priorities and pricing.",
          "<b>Acquisition flag:</b> Cisco acquired Splunk in March 2024. FIs with existing Splunk deployments should monitor licensing changes, support continuity, and roadmap direction as Cisco integrates Splunk into its broader security portfolio.",
          "<b>Watch:</b> Existing Splunk deployments remain viable. For new evaluations, compare Splunk's Cisco-era roadmap against Microsoft Sentinel and IBM QRadar Suite before committing to a multi-year contract."]}
];

const TIER_COLORS = { "FI Foundational":"#C084FC", "FI Elite":"#F2B33D", "FI Proven":"#ff4d55", "FI Active":"#6FA8FF", "FI Limited Signal":"#A9BCCB", "FI Minimal Signal":"#3C5F7E" };

function selectProvider(id) {
  const p = PROVIDERS.find(x => x.id === id);
  if (!p) return;

  let chips = `<span class="chip-tier ${p.tierClass}" style="color:#0A1724">${p.tier}</span>`;
  p.flags.forEach(f => {
    if (f === 'FI-Native')    chips += `<span class="chip-flag chip-fi">FI-Native</span>`;
    if (f === 'Acquisition')  chips += `<span class="chip-flag chip-acq">⚑ Acquisition</span>`;
  });
  document.getElementById('dChips').innerHTML = chips;
  document.getElementById('dWedge').innerHTML = `<span style="color:${p.wedgeColor}">${p.wedge}</span>`;
  document.getElementById('dName').textContent = p.name;
  document.getElementById('dReach').innerHTML = `Market: <span>${p.reach}</span>`;
  document.getElementById('dScore').textContent = p.score;

  const bar = document.getElementById('dBar');
  bar.style.width = (p.score / 10) + '%';
  bar.style.background = TIER_COLORS[p.tier] || '#ff4d55';

  document.getElementById('dText').innerHTML = p.text.map(t => `<p>${t}</p>`).join('');

  document.querySelectorAll('.row').forEach(r => r.setAttribute('aria-pressed','false'));
  const row = document.querySelector(`.row[data-id="${id}"]`);
  if (row) row.setAttribute('aria-pressed','true');

  document.querySelectorAll('.dot circle:not(.hit)').forEach(c => c.setAttribute('opacity','0.35'));
  document.querySelectorAll(`.dot[data-id="${id}"] circle:not(.hit)`).forEach(c => c.setAttribute('opacity','1'));
}

// Build list
const listEl = document.getElementById('providerList');
[...PROVIDERS].sort((a,b) => b.score - a.score).forEach((p, i) => {
  const btn = document.createElement('button');
  btn.className = 'row';
  btn.dataset.id = p.id;
  btn.setAttribute('aria-pressed','false');
  let flagHtml = '';
  if (p.flags.includes('FI-Native'))   flagHtml = `<span class="fl" style="color:#4ADE80">FI</span>`;
  else if (p.flags.includes('Acquisition')) flagHtml = `<span class="fl" style="color:#FF8A6B">ACQ</span>`;
  else flagHtml = `<span class="fl"></span>`;
  btn.innerHTML =
    `<span class="sw" style="background:${p.wedgeColor}"></span>` +
    `<span class="rk">#${i+1}</span>` +
    `<span class="nm">${p.name}</span>` +
    flagHtml +
    `<span class="tr">${p.tier}</span>` +
    `<span class="sc" style="color:${TIER_COLORS[p.tier]}">${p.score}</span>`;
  btn.addEventListener('click', () => selectProvider(p.id));
  listEl.appendChild(btn);
});

document.querySelectorAll('.dot').forEach(dot => {
  dot.addEventListener('click', () => selectProvider(parseInt(dot.dataset.id)));
  dot.addEventListener('keydown', e => { if (e.key==='Enter'||e.key===' ') selectProvider(parseInt(dot.dataset.id)); });
});

selectProvider(12); // default: Qualys (top scorer)

// Subscribe popup
var popupShown = false;
function showPopup() { if(popupShown)return; popupShown=true; document.getElementById('fr-overlay').classList.add('show'); }
function hidePopup() { document.getElementById('fr-overlay').classList.remove('show'); }
document.getElementById('fr-close').addEventListener('click', hidePopup);
document.getElementById('fr-overlay').addEventListener('click', function(e){ if(e.target===this) hidePopup(); });
window.addEventListener('scroll', function(){ if(!popupShown&&window.scrollY/(document.body.scrollHeight-window.innerHeight)>.55) showPopup(); },{passive:true});
setTimeout(showPopup, 45000);

var form = document.getElementById('fr-form');
form.addEventListener('submit', function(e) {
  e.preventDefault();
  var email = document.getElementById('fr-email').value;
  fetch('/', { method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body: new URLSearchParams(new FormData(form)).toString() });
  fetch('https://api.hsforms.com/submissions/v3/integration/submit/246649053/7025bf50-b249-481c-917a-4a687a5b1afa', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ fields:[{name:'email',value:email}], context:{pageUri:window.location.href,pageName:'FI Cybersecurity Providers'} })
  });
  document.getElementById('fr-default').style.display='none';
  document.getElementById('fr-success').style.display='flex';
  setTimeout(hidePopup, 2800);
});
</script>

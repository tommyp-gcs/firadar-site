<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AI Core Agents for FIs | FiRadar Segment Radar</title>
<meta name="description" content="FiRadar Segment Radar: Top 10 AI Core Agent providers for community banks and credit unions, scored on the FiRadar 0–1000 scale.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0A1724; --panel: #10243A; --panel-border: #24405A; --line: #2A4458;
    --fg: #E7EEF3; --fg2: #C9D6E0; --muted: #A9BCCB; --dim: #8AA0B2;
    --gold: #ffffff;
    --teal: #ff4d55; --coop: #ff7a80; --infra: #6FA8FF; --bank: #FF8A6B;
    --native: #4ADE80; --sel-bg: #18324D; --sel-border: #3C5F7E;
    --accent: #ff4d55; --accent2: #ff7a80;
    --mono: 'IBM Plex Mono', ui-monospace, monospace;
    --sans: 'IBM Plex Sans', system-ui, sans-serif;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
  a { color: var(--accent); } a:hover { color: var(--accent2); }
  button { font-family: inherit; }
  .wrap { max-width: 1440px; margin: 0 auto; padding: 36px 48px; display: flex; flex-direction: column; gap: 24px; }
  @media (max-width: 700px) { .wrap { padding: 24px 16px; } }

  /* NAV */
  .topnav { background: #061018; border-bottom: 1px solid var(--panel-border); }
  .topnav-inner { max-width: 1440px; margin: 0 auto; padding: 0 48px; height: 60px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  @media (max-width: 700px) { .topnav-inner { padding: 0 16px; } }
  .nav-brand { font-family: var(--mono); font-size: 18px; font-weight: 600; color: var(--gold); text-decoration: none; letter-spacing: .04em; }
  .nav-links { display: flex; gap: 24px; }
  .nav-links a { font-size: 14px; font-weight: 500; color: var(--muted); text-decoration: none; }
  .nav-links a:hover { color: var(--fg); }

  .head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }
  .eyebrow { font-family: var(--mono); font-size: 13px; letter-spacing: .18em; color: var(--accent); font-weight: 600; }
  h1 { margin: 6px 0; font-size: clamp(28px, 4vw, 38px); font-weight: 700; letter-spacing: -.01em; line-height: 1.1; }
  .sub { font-size: 16px; color: var(--muted); max-width: 900px; line-height: 1.5; }
  .meta { font-family: var(--mono); font-size: 13px; color: var(--muted); display: flex; flex-direction: column; gap: 4px; align-items: flex-end; }
  .meta span { color: var(--fg); }
  @media (max-width: 700px) { .meta { align-items: flex-start; } }

  .card { background: var(--panel); border: 1px solid var(--panel-border); border-radius: 12px; }
  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 900px) { .stats { grid-template-columns: 1fr; } }
  .stat { padding: 16px 20px; display: flex; gap: 16px; align-items: center; }
  .stat-num { font-family: var(--mono); font-size: 40px; font-weight: 600; color: var(--accent); line-height: 1; }
  .stat-label { font-size: 12px; letter-spacing: .1em; color: var(--muted); font-weight: 600; }
  .stat-note { font-size: 13px; line-height: 1.4; }

  .main { display: flex; gap: 40px; flex-wrap: wrap; align-items: flex-start; }
  .radar { flex: 0 1 760px; min-width: 0; width: 100%; }
  .radar svg { width: 100%; height: auto; display: block; }
  .radar svg .dot { cursor: pointer; }
  .side { flex: 999 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }

  .detail { padding: 20px 24px; display: flex; flex-direction: column; gap: 14px; }
  .detail-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .chips { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .chip-tier { font-family: var(--mono); font-size: 12px; font-weight: 600; padding: 3px 8px; border-radius: 4px; color: #0A1724; }
  .chip-flag { font-size: 12px; font-weight: 600; padding: 2px 8px; border-radius: 4px; border: 1px solid; }
  .chip-cu { border-color: var(--native); color: var(--native); }
  .chip-acq { border-color: #FF8A6B; color: #FF8A6B; }
  .d-wedge { font-size: 13px; font-weight: 600; }
  .d-name { font-size: 26px; font-weight: 700; line-height: 1.15; margin-top: 6px; }
  .d-reach { font-size: 13px; color: var(--muted); margin-top: 6px; }
  .d-reach span { color: var(--fg); }
  .d-score { font-family: var(--mono); font-size: 44px; font-weight: 600; line-height: 1; color: var(--accent); text-align: right; }
  .d-score-label { font-family: var(--mono); font-size: 11px; letter-spacing: .12em; color: var(--muted); }
  .bar { height: 8px; border-radius: 4px; background: var(--line); overflow: hidden; }
  .bar > div { height: 8px; border-radius: 4px; }
  .bar-ticks { display: flex; justify-content: space-between; font-family: var(--mono); font-size: 11px; color: var(--dim); margin-top: 6px; }
  .d-text { display: flex; flex-direction: column; gap: 10px; font-size: 14px; line-height: 1.45; }
  .d-text b { font-weight: 600; }

  .list { display: flex; flex-direction: column; gap: 4px; }
  .row { display: flex; align-items: center; gap: 12px; min-height: 36px; padding: 3px 10px; border-radius: 6px; border: 1px solid transparent; background: transparent; color: var(--fg); cursor: pointer; text-align: left; width: 100%; }
  .row:hover { background: #132B44; }
  .row[aria-pressed="true"] { background: var(--sel-bg); border-color: var(--sel-border); }
  .row .sw { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; }
  .row .rk { font-family: var(--mono); font-size: 12px; color: var(--muted); width: 22px; }
  .row .nm { font-size: 14px; font-weight: 500; flex-grow: 1; min-width: 0; }
  .row .fl { font-size: 11px; width: 60px; }
  .row .tr { font-size: 12px; color: var(--muted); width: 90px; }
  .row .sc { font-family: var(--mono); font-size: 14px; font-weight: 600; width: 40px; text-align: right; }
  @media (max-width: 560px) { .row .fl, .row .tr { display: none; } }
  .legend { font-size: 12px; color: var(--muted); line-height: 1.5; }

  h2 { margin: 0; font-size: 22px; font-weight: 700; }
  .dist-head { display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap; }
  .dist-head div { font-size: 14px; color: var(--muted); }
  .dist { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: 12px; }
  @media (max-width: 1100px) { .dist { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .dist { grid-template-columns: 1fr; } }
  .dist .card { padding: 18px 20px; }
  .dist h3 { margin: 0 0 8px; font-size: 15px; font-weight: 600; }
  .dist p { margin: 0; font-size: 13px; line-height: 1.5; color: var(--fg2); }

  footer { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; border-top: 1px solid var(--panel-border); padding-top: 16px; font-size: 12px; color: var(--dim); line-height: 1.6; }
  footer .brand { font-family: var(--mono); font-size: 14px; font-weight: 600; color: var(--accent); }
  footer .right { text-align: right; }
  @media (max-width: 700px) { footer .right { text-align: left; } }

  /* ── Subscribe popup ── */
  #fr-overlay {
    position: fixed; inset: 0; z-index: 200;
    background: rgba(5,10,22,0.78);
    backdrop-filter: blur(7px);
    display: none; align-items: center; justify-content: center; padding: 24px;
  }
  #fr-overlay.show { display: flex; }
  #fr-box {
    background: #10243A; border: 1px solid #3C5F7E; border-radius: 16px;
    padding: 36px 40px; max-width: 500px; width: 100%; position: relative;
    box-shadow: 0 20px 60px rgba(0,0,0,.55);
    animation: popIn .22s ease;
  }
  @keyframes popIn { from { opacity:0; transform:scale(.93) translateY(10px); } to { opacity:1; transform:none; } }
  #fr-close {
    position: absolute; top: 16px; right: 16px; width: 32px; height: 32px;
    background: none; border: none; color: var(--muted); cursor: pointer; font-size: 20px; line-height: 1;
  }
  #fr-close:hover { color: var(--fg); }
  #fr-eyebrow { font-family: var(--mono); font-size: 11px; letter-spacing: .2em; color: var(--accent); font-weight: 600; margin-bottom: 10px; }
  #fr-box h3 { margin: 0 0 8px; font-size: 22px; font-weight: 700; line-height: 1.2; }
  #fr-box p { margin: 0 0 20px; font-size: 14px; color: var(--muted); line-height: 1.5; }
  #fr-default, #fr-success { display: flex; flex-direction: column; gap: 0; }
  #fr-success { display: none; align-items: center; gap: 12px; }
  #fr-success svg { flex-shrink: 0; }
  #fr-success p { margin: 0; font-size: 15px; color: var(--fg2); }
  .fr-form { display: flex; gap: 10px; flex-wrap: wrap; }
  .fr-input {
    flex: 1; min-width: 0; background: #061018; border: 1px solid #3C5F7E; border-radius: 8px;
    padding: 11px 14px; font-family: var(--sans); font-size: 15px; color: var(--fg); outline: none;
  }
  .fr-input::placeholder { color: var(--dim); }
  .fr-input:focus { border-color: var(--accent); }
  .fr-btn {
    background: var(--accent); color: #fff; border: none; border-radius: 8px;
    padding: 11px 20px; font-family: var(--mono); font-size: 13px; font-weight: 600;
    letter-spacing: .08em; cursor: pointer; white-space: nowrap;
  }
  .fr-btn:hover { background: var(--accent2); }
  .fr-fine { font-size: 11px; color: var(--dim); margin-top: 10px; }

  /* Tier badge colors */
  .t-elite { background: #F2B33D; }
  .t-competitive { background: #ff4d55; }
  .t-developing { background: #6FA8FF; }
  .t-early { background: #A9BCCB; }
  .t-seed { background: #3C5F7E; }

  /* Wedge colors */
  .w-conv { color: #ff4d55; }
  .w-voice { color: #6FA8FF; }
  .w-platform { color: #4ADE80; }
  .w-enterprise { color: #FF8A6B; }
</style>
</head>
<body>

<!-- Hidden Netlify form for bot detection -->
<form name="research-subscribe" data-netlify="true" netlify-honeypot="bot-field" hidden>
  <input type="email" name="email">
  <input type="hidden" name="page">
</form>

<!-- Subscribe Overlay -->
<div id="fr-overlay" role="dialog" aria-modal="true" aria-label="Subscribe to FiRadar">
  <div id="fr-box">
    <button id="fr-close" aria-label="Close">✕</button>
    <div id="fr-eyebrow">FIRADAR RESEARCH</div>
    <h3>Get the next radar before it drops.</h3>
    <p>Community bank and CU leaders get our segment radars — scoring providers before you sign an LOI.</p>
    <div id="fr-default">
      <form class="fr-form" id="fr-form" name="research-subscribe" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="research-subscribe">
        <input type="hidden" name="page" value="AI Core Agents for FIs">
        <p style="display:none"><input name="bot-field"></p>
        <input class="fr-input" type="email" id="fr-email" name="email" placeholder="your@institution.org" required autocomplete="email">
        <button class="fr-btn" type="submit">SEND ME THE NEXT RADAR →</button>
      </form>
      <div class="fr-fine">No spam. Unsubscribe any time. FiRadar covers community banks &amp; credit unions only.</div>
    </div>
